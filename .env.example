# gsm2http configuration. Copy to .env and edit.
# Docker Compose reads this file for both the container and the compose settings;
# bare-metal starts (scripts/start.sh, systemd) read it too.

# --- Security ----------------------------------------------------------------
# Required. Bearer token for the REST API, the Socket.io stream and the web UI's sign-in.
# At least 32 characters; generate one with:  openssl rand -hex 32
# Clients send it as:  Authorization: Bearer <API_TOKEN>
API_TOKEN=

# gsm2http refuses to start without API_TOKEN. Set this to true only for local
# development on 127.0.0.1: without a token anyone who reaches the port can send SMS,
# dial, unlock the SIM and read every incoming message.
AUTH_DISABLED=false

# Browser origins allowed to call the API from another site (CORS), comma-separated,
# e.g. https://dashboard.example.lan:8443. Empty = same origin only, which is all the
# bundled UI and server-side clients (n8n, Home Assistant, curl) need.
CORS_ORIGINS=

# Per-modem limits on what API clients can do (in memory; a restart resets them).
# 0 disables a limit.
# Minimum gap between outgoing SMS on one modem (ms)
SMS_MIN_INTERVAL_MS=10000
# Outgoing SMS per modem per 24 h
SMS_DAILY_LIMIT=50
# Outgoing calls per modem per hour
CALLS_HOURLY_LIMIT=5
# SIM PIN unlock attempts per modem per hour. Independently of this, gsm2http never
# spends a SIM's last PIN attempt, so the API cannot PUK-lock it.
UNLOCK_HOURLY_LIMIT=3

# --- Modems ------------------------------------------------------------------
# 'auto' scans /dev/ttyUSB* and /dev/ttyACM* (USB modems only; on-board UARTs are never
# probed). Or a comma-separated list of ports to use exclusively, preferably stable
# by-id paths; '*' wildcards are allowed:
#   MODEM_PORTS=/dev/serial/by-id/usb-HUAWEI_*-if02-port0
MODEM_PORTS=auto

# Force a modem driver instead of auto-detection (see docs/ADDING_A_MODEM.md).
# A bare name applies to every port; otherwise comma-separated port=driver pairs.
# Built-in drivers: huawei, generic. Example: MODEM_DRIVER=/dev/ttyUSB2=generic
MODEM_DRIVER=

# Optional: SIM phone numbers per modem (modems cannot reliably read their own number).
# Keys are IMEI or lowercase model; JSON or comma-separated key=value pairs.
# Example: MODEM_NUMBERS=e173=+12025550100,000000000000002=+12025550101
MODEM_NUMBERS=

# How often to sweep SIM storage for SMS whose +CMTI notice was missed (ms, min 5000)
POLL_INTERVAL_MS=30000

# How often to look for newly plugged-in modems (ms, min 5000)
SCAN_INTERVAL_MS=15000

# Two simulated modems and the /api/mock/* endpoints, for development without hardware.
# The /api/mock/* endpoints do not exist unless this is true.
MOCK_MODE=false

# --- Events out: webhooks and MQTT -------------------------------------------
# Full reference: docs/events.md. For several sinks with different filters, use a
# config file instead (or as well): copy config.example.yaml to config.yaml.
CONFIG_FILE=

# Where events are POSTed as JSON (e.g. an n8n, Node-RED or Home Assistant webhook),
# http:// or https:// only.
# Comma-separate several URLs; each is retried independently.
WEBHOOK_URL=
# HMAC-SHA256 signing key; generate one with: openssl rand -hex 32
WEBHOOK_SECRET=
# Which events: names, families or *. Default: everything except modem.status.
# WEBHOOK_EVENTS=sms.*,call.*,modem.added,modem.removed
# WEBHOOK_TIMEOUT_MS=10000
# Attempts including the first; the default 6 retries for about 19 minutes.
# WEBHOOK_MAX_ATTEMPTS=6

# MQTT broker to publish every event to, e.g. mqtt://homeassistant.local:1883
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
# MQTT_TOPIC_PREFIX=gsm2http
# MQTT_EVENTS=*
# Make each modem a Home Assistant device (signal, SIM, SMS and call entities)
MQTT_HA_DISCOVERY=false

# At most one modem.status per modem per interval to webhooks and MQTT (0 = every change)
# MODEM_STATUS_MIN_INTERVAL_MS=10000

# --- Calls -------------------------------------------------------------------
# How long a dial keeps the call up unless the request says otherwise. Networks often need 8-10 s to start ringing.
DEFAULT_CALL_DURATION_MS=10000

# --- Server (bare metal) -----------------------------------------------------
# Listen address and port when running without Docker. Read docs/DEPLOYMENT.md before
# listening on anything but localhost.
HOST=127.0.0.1
PORT=9333

# info, or debug to log every AT command and response (contains phone numbers and PDUs)
LOG_LEVEL=info

# Directory of the built web UI to serve on the same port. Defaults to the bundled UI;
# set it empty to serve the API only.
# STATIC_DIR=

# --- Docker Compose ----------------------------------------------------------
# Host address and port to publish on. Localhost only by default; see docs/DEPLOYMENT.md.
GSM2HTTP_BIND=127.0.0.1
GSM2HTTP_PORT=9333
# Web UI port for docker-compose.split.yml
GSM2HTTP_WEB_PORT=9334
# Group id owning /dev/ttyUSB* on the host (stat -c %g /dev/ttyUSB0)
DIALOUT_GID=20
# Images to run instead of building locally, e.g. a published release tag
# GSM2HTTP_IMAGE=gsm2http:local
# docker-compose.split.yml:
# GSM2HTTP_BACKEND_IMAGE=gsm2http-backend:local
# GSM2HTTP_WEB_IMAGE=gsm2http-web:local

# --- Development --------------------------------------------------------------
# Backend the Vite dev server (npm run dev:frontend) proxies to
# GSM2HTTP_BACKEND=http://localhost:9333
